# Optional. The crypto claim checker works without keys.
ELEVENLABS_API_KEY=
# Optional automatic transcription of public Instagram Reel links.
SUPADATA_API_KEY=
# Optional Claude claim selection and explanations of supplied Gemini data. Server-only.
# Without a key, automatic Gemini checks use text rules and deterministic conclusions.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
PORT=3000

# Optional Gemini sandbox account connection. These are server-only settings.
# Register a confidential OAuth app in Gemini SANDBOX with orders:read,orders:create.
GEMINI_SANDBOX_CLIENT_ID=
GEMINI_SANDBOX_CLIENT_SECRET=
# Generate a random secret of at least 32 bytes. Do not reuse a Gemini credential.
GEMINI_SESSION_SECRET=
# Must exactly match the callback registered with Gemini (including the query).
GEMINI_REDIRECT_URI=http://localhost:3000/api/gemini-account?action=callback

# Live demo preparation only. Adding credentials does NOT enable trading.
# Choose one connection method after confirming the intended account flow.
# OAuth: each user authorizes their own account; requires Gemini app approval.
GEMINI_LIVE_CLIENT_ID=
GEMINI_LIVE_CLIENT_SECRET=
# Personal key: owner-only demo; requires private owner authentication first.
GEMINI_LIVE_API_KEY=
GEMINI_LIVE_API_SECRET=
# Read-only personal master-key connection; confirm time-based nonces in Gemini.
GEMINI_LIVE_NONCE_MODE=time
# Optional: exact account shortname from Gemini when the key has multiple accounts.
GEMINI_LIVE_ACCOUNT=
# Private owner dashboard. Hash a random 32-byte base64url access code using SHA-256.
# Store the raw code separately and privately; never deploy it or use a Gemini key as the code.
GEMINI_LIVE_OWNER_CODE_HASH=
GEMINI_LIVE_SESSION_SECRET=
GEMINI_LIVE_APP_ORIGIN=https://your-app.example
# For local testing only: set NODE_ENV=development and origin=http://localhost:3000.
# Persistent order journal and $5 demo reservations (not temporary scratch storage).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
