# Optional. The crypto claim checker works without keys.
ELEVENLABS_API_KEY=
# Optional automatic transcription of public Instagram Reel links.
SUPADATA_API_KEY=
# Optional Claude claim selection and explanations of supplied Gemini data. Server-only.
# Without a key, automatic Gemini checks use text rules and deterministic conclusions.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
PORT=3000

# Optional Gemini sandbox account connection. These are server-only settings.
# Register a confidential OAuth app in Gemini SANDBOX with orders:read,orders:create.
GEMINI_SANDBOX_CLIENT_ID=
GEMINI_SANDBOX_CLIENT_SECRET=
# Generate a random secret of at least 32 bytes. Do not reuse a Gemini credential.
GEMINI_SESSION_SECRET=
# Must exactly match the callback registered with Gemini (including the query).
GEMINI_REDIRECT_URI=http://localhost:3000/api/gemini-account?action=callback

# Separate owner-only real-money demo. Disabled unless explicitly set to true.
# Every order still requires the owner's private session, review and manual confirmation.
GEMINI_LIVE_TRADING_ENABLED=false
# Reserved for a future OAuth flow; leave both unset for the current personal-key demo.
# Configuring both OAuth and personal-key credentials disables live readiness.
GEMINI_LIVE_CLIENT_ID=
GEMINI_LIVE_CLIENT_SECRET=
# Personal master key: server-only. Account reads and Trader role are required.
GEMINI_LIVE_API_KEY=
GEMINI_LIVE_API_SECRET=
# Confirm this key is configured for time-based nonces in Gemini before use.
GEMINI_LIVE_NONCE_MODE=time
# Optional: exact account shortname from Gemini when the key has multiple accounts.
GEMINI_LIVE_ACCOUNT=
# Private owner dashboard: sessions last 15 minutes; order reviews expire within 2 minutes.
# Hash a random 32-byte base64url access code using SHA-256.
# Store the raw code separately and privately; never deploy it or use a Gemini key as the code.
GEMINI_LIVE_OWNER_CODE_HASH=
# Use a separate random secret of at least 32 bytes.
GEMINI_LIVE_SESSION_SECRET=
GEMINI_LIVE_APP_ORIGIN=https://your-app.example
# For local testing only: set NODE_ENV=development and origin=http://localhost:3000.
# Persistent Upstash journal, eviction disabled. Preserve the same database across deployments.
# Lifetime $5 account limit includes principal + a fee reserve based on the verified fill step.
# Whole-contract orders may fill fractionally: .01 step reserves $1/contract; 1 step reserves 3 cents.
# Reservations are never automatically refunded, including rejected or unfilled orders.
# Unknown/submitting outcomes block further orders. Never reset the database to clear a gate/budget.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
